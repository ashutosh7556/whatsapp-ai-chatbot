# ---- WhatsApp Cloud API config (CityHospital) ----

# A token YOU invent. Any random string.
# You enter this SAME value in Meta dashboard:
# WhatsApp > Configuration > Webhook > "Verify token".
VERIFY_TOKEN=my_secret_verify_token

# Temporary access token from Meta.
# Get it: Meta App Dashboard > WhatsApp > API Setup > "Temporary access token".
# NOTE: test token expires in ~24h. Regenerate when it stops working.
WHATSAPP_TOKEN=your_whatsapp_access_token_here

# The Phone number ID of the free test number.
# Get it: Meta App Dashboard > WhatsApp > API Setup > "Phone number ID"
# (this is NOT the phone number itself, it's the numeric ID under it).
PHONE_NUMBER_ID=your_phone_number_id_here

# Local port the server runs on.
PORT=3000
